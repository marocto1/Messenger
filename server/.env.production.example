NODE_ENV=production
PORT=4000
DATA_DIR=/srv/marocto/data
ALLOWED_ORIGIN=https://messenger.your-domain,https://tauri.localhost,http://tauri.localhost,https://localhost,capacitor://localhost
SECURITY_MASTER_KEY=REPLACE_WITH_32_OR_MORE_RANDOM_CHARACTERS
WEBAUTHN_RP_ID=messenger.your-domain
WEBAUTHN_RP_NAME=Marocto Messenger
WEBAUTHN_ORIGINS=https://messenger.your-domain
TOTP_ISSUER=Marocto Messenger
TRUST_PROXY=true
ALLOW_LOCAL_WEBHOOKS=false
TURN_URL=turn:turn.your-domain:3478?transport=udp,turns:turn.your-domain:5349?transport=tcp
TURN_USERNAME=REPLACE_ME
TURN_CREDENTIAL=REPLACE_ME
