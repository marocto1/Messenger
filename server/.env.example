# Local development. Keep secrets out of version control.
PORT=4000
ALLOWED_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://tauri.localhost,https://tauri.localhost,tauri://localhost,capacitor://localhost,http://localhost,https://localhost
SECURITY_MASTER_KEY=development-only-change-me-before-production
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Marocto Messenger
WEBAUTHN_ORIGINS=http://localhost:3000
TOTP_ISSUER=Marocto Messenger
